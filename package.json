{
  "name": "devlauncher",
  "version": "1.0.0",
  "description": "本地开发项目管理系统",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:main": "tsc --project tsconfig.electron.json && npx copyfiles -f src/main/preload.js dist/main",
    "build": "vite build && npm run build:main",
    "electron:dev": "concurrently --kill-others --kill-others-on-fail --names \"VITE,ELECTRON\" --prefix-colors \"blue,green\" \"npm run dev\" \"npm run build:main && wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "electron",
    "project-management",
    "developer-tools"
  ],
  "author": {
    "name": "Jasper Leung",
    "email": "jasper@devlauncher.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jasper-Leung/devlauncher.git"
  },
  "bugs": {
    "url": "https://github.com/Jasper-Leung/devlauncher/issues"
  },
  "homepage": "https://github.com/Jasper-Leung/devlauncher#readme",
  "build": {
    "appId": "com.devlauncher.app",
    "productName": "DevLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DevLauncher-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "electron": "^40.0.0",
    "i18next": "^25.8.4",
    "node-pty": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.0.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  }
}
